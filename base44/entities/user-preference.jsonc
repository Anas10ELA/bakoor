{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "display_name": { "type": "string" },
    "language": { "type": "string", "enum": ["ar", "en"], "default": "ar" },
    "city": { "type": "string", "default": "Cairo" },
    "country": { "type": "string", "default": "Egypt" },
    "timezone": { "type": "string", "default": "Africa/Cairo" },
    "calculation_method": { "type": "integer", "minimum": 0, "maximum": 99, "default": 5 },
    "theme": { "type": "string", "enum": ["auto", "day", "night", "system"], "default": "auto" },
    "day_start_time": { "type": "string", "format": "time", "default": "04:00" },
    "day_end_time": { "type": "string", "format": "time", "default": "23:00" },
    "sleep_start_time": { "type": "string", "format": "time", "default": "22:30" },
    "wake_offset_before_fajr": { "type": "integer", "minimum": 0, "maximum": 180, "default": 30 },
    "commitment_type": { "type": "string", "enum": ["none", "work", "study", "mixed"], "default": "none" },
    "commitment_start_time": { "type": "string", "format": "time", "default": "08:00" },
    "commitment_end_time": { "type": "string", "format": "time", "default": "15:00" },
    "commute_minutes": { "type": "integer", "minimum": 0, "maximum": 180, "default": 0 },
    "reserve_breakfast": { "type": "boolean", "default": false },
    "breakfast_time": { "type": "string", "format": "time", "default": "07:00" },
    "breakfast_duration_minutes": { "type": "integer", "minimum": 10, "maximum": 180, "default": 30 },
    "reserve_lunch": { "type": "boolean", "default": false },
    "lunch_time": { "type": "string", "format": "time", "default": "14:30" },
    "lunch_duration_minutes": { "type": "integer", "minimum": 10, "maximum": 180, "default": 30 },
    "reserve_dinner": { "type": "boolean", "default": false },
    "dinner_time": { "type": "string", "format": "time", "default": "20:30" },
    "dinner_duration_minutes": { "type": "integer", "minimum": 10, "maximum": 180, "default": 30 },
    "reserve_family_time": { "type": "boolean", "default": false },
    "family_time": { "type": "string", "format": "time", "default": "19:00" },
    "family_duration_minutes": { "type": "integer", "minimum": 15, "maximum": 360, "default": 60 },
    "peak_energy_anchor": { "type": "string", "enum": ["after_fajr", "morning", "after_dhuhr", "after_asr", "after_isha"], "default": "after_fajr" },
    "low_energy_anchor": { "type": "string", "enum": ["after_dhuhr", "after_asr", "evening", "after_isha"], "default": "after_isha" },
    "planning_style": { "type": "string", "enum": ["gentle", "balanced", "ambitious"], "default": "balanced" },
    "target_buffer_minutes": { "type": "integer", "minimum": 30, "maximum": 240, "default": 90 },
    "deep_work_session_minutes": { "type": "integer", "minimum": 30, "maximum": 120, "default": 90 },
    "profile_version": { "type": "integer", "minimum": 1, "default": 1 },
    "evening_planning_enabled": { "type": "boolean", "default": true },
    "evening_planning_offset_minutes": { "type": "integer", "minimum": 0, "maximum": 180, "default": 30 },
    "last_planned_date": { "type": "string", "format": "date", "description": "Most recent day path approved by the user" },
    "last_plan_variant": { "type": "string", "enum": ["full", "balanced", "minimum"], "default": "balanced" },
    "onboarding_complete": { "type": "boolean", "default": false }
  },
  "required": ["display_name"],
  "rls": {
    "create": { "user_condition": { "id": "{{user.id}}" } },
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
